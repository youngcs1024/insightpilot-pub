# Documentation only: test infrastructure never loads dotenv files implicitly.
# Export these only for a dedicated runner-local, already bootstrapped service.
INSIGHTPILOT_TEST_REQUIRE_DOCKER=true
INSIGHTPILOT_TEST_POSTGRES__HOST=127.0.0.1
INSIGHTPILOT_TEST_POSTGRES__PORT=5432
INSIGHTPILOT_TEST_POSTGRES__PASSWORD=ci-only-postgres
INSIGHTPILOT_TEST_POSTGRES__APP_PASSWORD=ci-only-app
