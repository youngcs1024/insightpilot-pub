# Copy to the project root as .env.provider-probe; fill only these two values.
IP_SPIKE_PROVIDER__WORKSPACE_ID=
IP_SPIKE_PROVIDER__API_KEY=

# Optional bounded limits; never store credentials in CLI arguments.
IP_SPIKE_PROVIDER__TIMEOUT_SECONDS=60
IP_SPIKE_PROVIDER__DEADLINE_SECONDS=900
IP_SPIKE_PROVIDER__MAX_ATTEMPTS=2
