# Remote inference process only: copy to .env.model-runtime.
# Replace dummy revisions with the verified immutable model commits.
# This file carries no GPU selection/cache/image deployment inputs or DB credentials.
IP_ENVIRONMENT=production
IP_MODEL_SERVER__AUTH_TOKEN='replace-with-model-service-token'
IP_MODEL_SERVER__EMBED_REVISION=0000000000000000000000000000000000000000
IP_MODEL_SERVER__RERANK_REVISION=0000000000000000000000000000000000000000
IP_MODEL_SERVER__DEVICE=cuda:0
IP_MODEL_SERVER__PRECISION=fp16
IP_MODEL_SERVER__WORKERS=1
IP_MODEL_SERVER__MAX_CONCURRENCY=1
IP_MODEL_SERVER__QUEUE_CAPACITY=8
IP_MODEL_SERVER__EMBED_BATCH=16
IP_MODEL_SERVER__RERANK_BATCH=16
IP_MODEL_SERVER__EMBED_MAX_LENGTH=512
IP_MODEL_SERVER__RERANK_MAX_LENGTH=320
