# Copy to .env.retrieve.local; only app DML, Milvus and optional model HTTP settings.
IP_ENVIRONMENT=development
IP_DATABASE__HOST=127.0.0.1
IP_DATABASE__PORT=15432
IP_DATABASE__APP_DB=insightpilot_app
IP_DATABASE__APP_USER=app_rw
IP_DATABASE__APP_PASSWORD='replace-with-independent-app-secret'
IP_DATABASE__POOL_SIZE=10
IP_DATABASE__POOL_RECYCLE_S=1800
IP_DATABASE__MAX_OVERFLOW=5
IP_DATABASE__POOL_TIMEOUT_S=30
IP_DATABASE__CONNECT_TIMEOUT_S=5
IP_DATABASE__COMMAND_TIMEOUT_S=10
IP_DATABASE__ECHO_SQL=false
IP_RETRIEVAL__ENABLED=false
# IP_MODEL_RUNTIME__BASE_URL=http://model-tunnel:8100
# IP_MODEL_RUNTIME__AUTH_TOKEN='replace-with-model-service-token'
# IP_MODEL_RUNTIME__EMBED_BATCH=16
# IP_MODEL_RUNTIME__MAX_CONCURRENCY=1
IP_RETRIEVAL__SEARCH_TIMEOUT_S=10
# IP_MODEL_RUNTIME__EMBED_TIMEOUT_S=20
# IP_MODEL_RUNTIME__RERANK_TIMEOUT_S=30
IP_RETRIEVAL__MILVUS__URI=http://milvus:19530
IP_RETRIEVAL__MILVUS__COLLECTION=kb_chunks
IP_RETRIEVAL__MILVUS__DIMENSION=1024
IP_RETRIEVAL__MILVUS__TIMEOUT_S=10
IP_RETRIEVAL__MILVUS__STARTUP_TIMEOUT_S=90
IP_RETRIEVAL__MILVUS__HNSW_M=16
IP_RETRIEVAL__MILVUS__EF_CONSTRUCTION=200
IP_RETRIEVAL__MILVUS__SEARCH_EF=64
IP_RETRIEVAL__MILVUS__DROP_RATIO_BUILD=0.2
IP_RETRIEVAL__MILVUS__PROTECTED_TERMS='["SKU-A1023","SKU-B2048"]'
IP_MODEL_RUNTIME__EMBED_REVISION=5617a9f61b028005a4858fdac845db406aefb181
IP_MODEL_RUNTIME__RERANK_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
IP_MODEL_RUNTIME__PRECISION=fp16

# Bounded query search; does not enable the knowledge graph.
IP_RETRIEVAL__SEARCH__USE_DENSE=true
IP_RETRIEVAL__SEARCH__USE_SPARSE_LEARNED=true
IP_RETRIEVAL__SEARCH__USE_BM25=true
IP_RETRIEVAL__SEARCH__POOL=20
IP_RETRIEVAL__SEARCH__HNSW_EF=64
IP_RETRIEVAL__SEARCH__RRF_K=60
IP_RETRIEVAL__SEARCH__DROP_RATIO_SEARCH=0.2
IP_RETRIEVAL__SEARCH__RECORD_ARM_SCORES=true
IP_TIMEOUT_S=90
