# Tunnel wrapper only. Copy to .env.tunnel; replace with existing selected files.
# These are dummy inputs, not discovered hosts, trusted keys, or working paths.
IP_ENVIRONMENT=development
IP_TUNNEL__JUMP_HOST=jump.example.invalid
IP_TUNNEL__JUMP_USER=replace-jump-user
IP_TUNNEL__JUMP_PORT=22
IP_TUNNEL__TARGET_HOST=model.example.invalid
IP_TUNNEL__TARGET_USER=replace-target-user
IP_TUNNEL__TARGET_PORT=22
IP_TUNNEL__JUMP_KEY_PATH=/replace/insightpilot/ssh/jump_key
IP_TUNNEL__TARGET_KEY_PATH=/replace/insightpilot/ssh/target_key
IP_TUNNEL__KNOWN_HOSTS_PATH=/replace/insightpilot/ssh/known_hosts
IP_TUNNEL__CONFIG_PATH=/replace/insightpilot/ssh/config
IP_TUNNEL__HOST_PORT=18100
