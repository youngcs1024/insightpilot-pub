# Documentation only. CI injects these values; no dotenv file is loaded.
# Never copy a real GitHub token into this file.
IP_CI_TOKEN=ci-example-placeholder
IP_CI_REPOSITORY=owner/insightpilot
IP_CI_EVENT=push
IP_CI_TESTED_SHA=0000000000000000000000000000000000000000
IP_CI_RUN_ID=1
IP_CI_EVENT_PATH=/tmp/ci-event.json
IP_CI_OUTPUT=/tmp/ci-output
IP_CI_SUMMARY=/tmp/ci-summary
