# Copy to .env.route.local. Prefilter-only questions need no provider configuration.
IP_ENVIRONMENT=development
IP_ROUTER__MIN_CONFIDENCE=0.6
IP_ROUTER__STRATEGY=hybrid
IP_TIMEOUT_S=90
# Configure all three required provider fields together to enable LLM routing.
# IP_LLM__BASE_URL=https://example.invalid/v1
# IP_LLM__MODEL=qwen3.6-flash-2026-04-16
# IP_LLM__API_KEY='replace-with-provider-key'
# IP_LLM__TIMEOUT_S=45
# IP_LLM__ROLES={}
# IP_LLM__CAPABILITIES_PATHS=["app/resources/provider_capabilities.json"]
