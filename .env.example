# Seed operator settings live separately in .env.seed.example; never merge them here.
# API only: copy to .env.api and replace the connection values and secrets.
# Never source .env.deployment or inject deployment/SSH/server credentials here.
# Secret values are dummy placeholders; no service is called by configuration loading.
# Set IP_ENVIRONMENT in the shell to select environment-specific process files.
IP_ENVIRONMENT=development
IP_DATABASE__HOST=127.0.0.1
IP_DATABASE__PORT=15432
IP_DATABASE__APP_DB=insightpilot_app
IP_DATABASE__APP_USER=app_rw
IP_DATABASE__APP_PASSWORD='replace-with-independent-app-secret'
IP_DATABASE__POOL_SIZE=10
IP_DATABASE__POOL_RECYCLE_S=1800
IP_DATABASE__MAX_OVERFLOW=5
IP_DATABASE__POOL_TIMEOUT_S=30
IP_DATABASE__CONNECT_TIMEOUT_S=5
IP_DATABASE__COMMAND_TIMEOUT_S=10
IP_DATABASE__ECHO_SQL=false
IP_LLM__BASE_URL=https://llm-REPLACE.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
IP_LLM__MODEL=qwen3.6-flash-2026-04-16
IP_LLM__API_KEY='replace-with-llm-api-key'
IP_RETRIEVAL__ENABLED=false
IP_RETRIEVAL__EVIDENCE__MAX_TOKENS=6000
IP_MCP__BASE_URL=http://mcp:8001/mcp
IP_MCP__AUTH_TOKEN='replace-with-independent-mcp-token'
# These are explicit overrides; omit to use environment-sensitive defaults.
# IP_OBSERVABILITY__LOG_LEVEL=DEBUG
# IP_OBSERVABILITY__LOG_FORMAT=console
IP_OBSERVABILITY__LANGFUSE_ENABLED=false
# Required together when Langfuse is enabled:
# IP_OBSERVABILITY__LANGFUSE_BASE_URL=https://cloud.langfuse.com
# IP_OBSERVABILITY__LANGFUSE_PUBLIC_KEY='replace-with-langfuse-public-key'
# IP_OBSERVABILITY__LANGFUSE_SECRET_KEY='replace-with-langfuse-secret-key'
# Retained for compatibility; true is rejected in every environment.
IP_OBSERVABILITY__LANGFUSE_MASK_DISABLED=false
IP_SEMANTIC_MEMORY_ENABLED=false
# Uncomment the complete model client block when either feature needs encoding:
# IP_MODEL_RUNTIME__BASE_URL=http://model-tunnel:8100
# IP_MODEL_RUNTIME__AUTH_TOKEN='replace-with-model-service-token'
# IP_MODEL_RUNTIME__EMBED_BATCH=16
# IP_MODEL_RUNTIME__MAX_CONCURRENCY=1
# Container process config must set database host/port to postgres/5432.
# Explicit host retrieval development uses http://127.0.0.1:18100.
# MCP is private to Compose; host-only loading does not prove network readiness.
# Values containing $ or # should be single-quoted. Password URL encoding is
# performed by DatabaseSettings.app_url using urllib.parse.quote_plus (@ : / + space).

# Step 1.1 HTTP edge and whole-operation readiness budgets.
IP_HTTP__REQUEST_TIMEOUT_S=90
IP_HTTP__FINALIZATION_GRACE_S=5
IP_HTTP__SHUTDOWN_TIMEOUT_S=10
IP_HTTP__CORS_ORIGINS='[]'
IP_HTTP__CORS_ALLOW_CREDENTIALS=false
IP_HEALTH__POSTGRESQL_TIMEOUT_S=2
IP_HEALTH__MCP_TIMEOUT_S=3

# Per-operation budgets (total request budget still applies).
IP_LLM__TIMEOUT_S=45
IP_MCP__TIMEOUT_S=15
IP_RETRIEVAL__SEARCH_TIMEOUT_S=10
# IP_MODEL_RUNTIME__EMBED_TIMEOUT_S=20
# IP_MODEL_RUNTIME__RERANK_TIMEOUT_S=30

# Step 1.6: independent API-only signing secret; replace with random >=32 characters.
IP_SECURITY__JWT_SECRET='replace-with-independent-random-jwt-secret'
IP_SECURITY__ACCESS_TTL_MINUTES=30
IP_SECURITY__REFRESH_TTL_DAYS=14
IP_SECURITY__BCRYPT_ROUNDS=12
# All rules apply. Memory backend requires a single process; restart resets quotas.
IP_RATE_LIMITS__REGISTER_RULES='[{"requests":5,"seconds":3600}]'
IP_RATE_LIMITS__LOGIN_RULES='[{"requests":10,"seconds":60}]'
IP_RATE_LIMITS__REFRESH_RULES='[{"requests":20,"seconds":3600}]'
IP_RATE_LIMITS__ME_RULES='[{"requests":60,"seconds":60}]'

# Step 1.8: JSON role overrides; missing roles inherit MODEL/TIMEOUT_S.
# Example role: {"sql":{"model":"qwen3.6-flash-2026-04-16","temperature":0,"max_tokens":2048,"timeout_s":45,"fallback_models":[]}}
IP_LLM__ROLES={}
IP_LLM__CAPABILITIES_PATHS=["app/resources/provider_capabilities.json"]

IP_RATE_LIMITS__CONVERSATIONS_RULES='[{"requests":60,"seconds":60}]'
IP_RATE_LIMITS__MESSAGES_RULES='[{"requests":20,"seconds":60}]'

# Step 2.2 semantic catalog
IP_DATA_AGENT__SCHEMA_STRATEGY=full
IP_ROUTER__MIN_CONFIDENCE=0.6
# Advisory only: exact, unique result aliases; empty lists disable business expectations.
IP_DATA_AGENT__SANITY__EXTREME_MAGNITUDE=1000000000000
IP_DATA_AGENT__SANITY__MONEY_COLUMNS=[]
IP_DATA_AGENT__SANITY__NONZERO_COLUMNS=[]
# Unset means no cardinality expectation. Enable only for a known result shape.
# IP_DATA_AGENT__SANITY__EXPECTED_MAX_ROWS=1000
IP_SCHEMA_CATALOG__TTL_S=300
IP_SCHEMA_CATALOG__OPERATION_TIMEOUT_S=30

# Step 3.1 storage: vocabulary changes require a new collection and reindex.
IP_RETRIEVAL__MILVUS__URI=http://milvus:19530
IP_RETRIEVAL__MILVUS__COLLECTION=kb_chunks
IP_RETRIEVAL__MILVUS__DIMENSION=1024
IP_RETRIEVAL__MILVUS__TIMEOUT_S=10
IP_RETRIEVAL__MILVUS__STARTUP_TIMEOUT_S=90
IP_RETRIEVAL__MILVUS__HNSW_M=16
IP_RETRIEVAL__MILVUS__EF_CONSTRUCTION=200
IP_RETRIEVAL__MILVUS__SEARCH_EF=64
IP_RETRIEVAL__MILVUS__DROP_RATIO_BUILD=0.2
IP_RETRIEVAL__MILVUS__PROTECTED_TERMS='["SKU-A1023","SKU-B2048"]'

IP_MODEL_RUNTIME__EMBED_REVISION=5617a9f61b028005a4858fdac845db406aefb181
IP_MODEL_RUNTIME__RERANK_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
IP_MODEL_RUNTIME__PRECISION=fp16

# Bounded query search; does not enable the knowledge graph.
IP_RETRIEVAL__SEARCH__USE_DENSE=true
IP_RETRIEVAL__SEARCH__USE_SPARSE_LEARNED=true
IP_RETRIEVAL__SEARCH__USE_BM25=true
IP_RETRIEVAL__SEARCH__POOL=20
IP_RETRIEVAL__SEARCH__HNSW_EF=64
IP_RETRIEVAL__SEARCH__RRF_K=60
IP_RETRIEVAL__SEARCH__DROP_RATIO_SEARCH=0.2
IP_RETRIEVAL__SEARCH__RECORD_ARM_SCORES=false

# Batched child-chunk reranking and normalized dynamic filtering.
IP_RETRIEVAL__SEARCH__USE_RERANK=true
IP_RETRIEVAL__SEARCH__FILTERING__DYNAMIC_RATIO=0.5
IP_RETRIEVAL__SEARCH__FILTERING__ABSOLUTE_FLOOR=0.30
IP_RETRIEVAL__SEARCH__FILTERING__HIGH_RATIO=0.6
IP_RETRIEVAL__SEARCH__FILTERING__MIN_PER_DOC=1
IP_RETRIEVAL__SEARCH__FILTERING__MAX_PER_DOC=3
IP_RETRIEVAL__SEARCH__FILTERING__GAP_THRESHOLD=0.15
IP_RETRIEVAL__SEARCH__FILTERING__FINAL_K=8
