# Operator-only. Copy to .env.migration; never inject into API/MCP containers.
IP_ENVIRONMENT=development
IP_MIGRATION__HOST=127.0.0.1
IP_MIGRATION__PORT=15432
IP_MIGRATION__USER=postgres
IP_MIGRATION__PASSWORD=replace-with-insightpilot-operator-password
IP_MIGRATION__CONNECT_TIMEOUT_S=5
IP_MIGRATION__COMMAND_TIMEOUT_S=30
IP_MIGRATION__LOCK_TIMEOUT_S=5
