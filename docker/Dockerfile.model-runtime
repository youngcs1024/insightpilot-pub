# syntax=docker/dockerfile:1@sha256:ecfaec9ed6d810b56388c508f4121597bfbba70d41a6dfeee4d8cad5f295fc32
FROM ghcr.io/astral-sh/uv:0.11.32 AS uv
FROM python:3.12.13-slim-bookworm@sha256:4766d8b510c428e595d74b9cc5bbb2fae8e26316fffb4adc89908d79aacd58a2 AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && groupadd --gid 10001 appuser && useradd --uid 10001 --gid 10001 --no-create-home appuser
WORKDIR /opt/insightpilot
COPY model_runtime/pyproject.toml model_runtime/uv.lock ./
# A mounted installer and temporary hardlink cache avoid two copies of CUDA wheels.
# No compiler/uv binary remains in the runtime; every package is still lock-selected.
RUN --mount=from=uv,source=/uv,target=/usr/local/bin/uv uv sync --frozen --no-dev --no-install-project --no-cache --link-mode=hardlink
COPY app/__init__.py ./app/
COPY app/core/__init__.py app/core/errors.py app/core/settings_base.py app/core/background.py ./app/core/
COPY app/schemas/__init__.py app/schemas/mcp.py app/schemas/model_runtime.py ./app/schemas/
COPY model_runtime/*.py ./model_runtime/
ENV PATH="/opt/insightpilot/.venv/bin:$PATH" PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_HOME=/models OMP_NUM_THREADS=4
USER appuser
HEALTHCHECK --interval=10s --timeout=3s --start-period=120s --retries=6 CMD ["python", "-m", "model_runtime.probe", "--ready"]
CMD ["python", "-m", "model_runtime.server"]
